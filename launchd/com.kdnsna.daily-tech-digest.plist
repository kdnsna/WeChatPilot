  <key>StandardOutPath</key>
  <string>/Users/kdnsna/Documents/微信 chat/logs/launchd.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/kdnsna/Documents/微信 chat/logs/launchd.stderr.log</string>
</dict>
</plist>
